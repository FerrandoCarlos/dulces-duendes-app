@{
    ViewData["Title"] = "Productos";
}
<div id="app-productos">
    <h1 class="h3 mb-3">Productos</h1>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>

    <input type="search" class="form-control mb-3" v-model="texto"
           placeholder="Buscar producto por código o descripción..." />

    <div class="btn-group mb-3" role="group" aria-label="Filtrar por estado de stock">
        <button type="button" class="btn btn-outline-primary" :class="{ active: estado === 'Todos' }"
        @@click="estado = 'Todos'">Todos</button>
        <button type="button" class="btn btn-outline-primary" :class="{ active: estado === 'ConStock' }"
        @@click="estado = 'ConStock'">Con stock</button>
        <button type="button" class="btn btn-outline-primary" :class="{ active: estado === 'StockBajo' }"
        @@click="estado = 'StockBajo'">Stock bajo</button>
        <button type="button" class="btn btn-outline-primary" :class="{ active: estado === 'SinStock' }"
        @@click="estado = 'SinStock'">Sin stock</button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Precio venta</th>
                    <th class="text-end">Cuenta corriente</th>

                </tr>
            </thead>
            <tbody>
                <tr v-if="cargando">
                    <td colspan="6" class="text-center text-muted">Cargando...</td>
                </tr>
                <tr v-else-if="items.length === 0">
                    <td colspan="6" class="text-center text-muted">No hay productos.</td>
                </tr>
                <tr v-for="p in items" :key="p.id">
                    <td>{{ p.codigoBarra }}</td>
                    <td>{{ p.descripcion }}</td>
                    <td>{{ p.tipoProductoNombre }}</td>
                    <td class="text-end">{{ p.stock }}</td>
                    <td class="text-end">{{ formatoPrecio(p.precioVenta) }}</td>
                    <td class="text-end">{{ formatoPrecio(p.precioCuentaCorriente) }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <nav v-if="totalPaginas>1" aria-label="Paginación de productos">
        <ul class="pagination">
            <li class="page-item" :class="{disabled: pagina === 1}">
                <button type="button" class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página {{pagina}} de {{totalPaginas}}</span>
            </li>
            <li class="page-item" :class="{disabled: pagina === totalPaginas}">
                <button type="button" class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Total: {{ total }}</p>
</div>
@section Scripts {
    <script src="~/lib/vue/vue.global.js"></script>
    <script src="~/js/productos.js" asp-append-version="true"></script>
}
