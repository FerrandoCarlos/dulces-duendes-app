<div class="modal fade" id="modalAnulacionTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" v-if="ticketAnular">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Anulación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="fs-5 mb-2">
                    ¿Está seguro de que desea anular el <strong>Ticket #{{ ticketAnular.id }}</strong>?
                </p>
                <div class="alert alert-warning mb-0 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Esta acción marcará la venta como inactiva y devolverá automáticamente los productos involucrados al inventario.
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="procesandoAnulacion">
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" v-on:click="confirmarAnulacion" :disabled="procesandoAnulacion">
                    <span v-if="procesandoAnulacion" class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <i v-else class="bi bi-x-circle me-1"></i>
                    Anular Venta
                </button>
            </div>
        </div>
    </div>
</div>