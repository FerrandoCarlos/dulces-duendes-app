@using DulcesDuendesApp.Common.Pagination
@model PagedResult<DulcesDuendesApp.Models.Ticket>

@{
    ViewData[index: "Title"] = "Tickets";
}

<div class="page-header">
    <h1>Tickets</h1>
</div>


<form style="display:none">@Html.AntiForgeryToken()</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<script id="ticket-data-json" type="application/json">
    @Html.Raw(Json.Serialize(Model))
</script>

<form id="antiForgeryForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div id="app-tickets" v-cloak>
    
    <div v-if="error" class="alert alert-danger">{{ error }}
        <button type="button" class="btn-close" v-on:click="error = ''"></button>
    </div>

    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Fecha Desde</label>
                    <input type="date" class="form-control" v-model="fechaDesde" v-on:input="filtrarTickets" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Fecha Hasta</label>
                    <input type="date" class="form-control" v-model="fechaHasta" :min="fechaDesde" v-on:input="filtrarTickets"  />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100" v-on:click="limpiarFiltros" title="Limpiar Filtros">
                        <i class="bi bi-eraser me-1"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="table-panel">
        <table class="table table-striped" id="tablaTickets">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Creado por</th>
                    <th>Cliente</th>
                    <th>Tipo de pago</th>
                    <th>Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="cargando">
                    <td colspan="6" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <span class="ms-2">Cargando tickets...</span>
                    </td>
                </tr>
                <tr v-else-if="tickets.length === 0">
                    <td colspan="6" class="text-center text-muted py-4">
                        No se encontraron tickets que coincidan con la fecha.
                    </td>
                </tr>
                <tr v-else v-for="ticket in tickets" :key="ticket.id">
                    <td>{{ formatFecha(ticket.fecha) }}</td>
                    <td>
                        <i class="bi bi-person-circle me-1 text-secondary"></i>
                        {{ ticket.usuarioNombre }}
                    </td>
                    <td>{{ ticket.clienteNombre || 'Consumidor Final' }}</td>
                    <td>
                        <span class="badge" :class="ticket.tipoPago === 'Efectivo' ? 'bg-success' : 'bg-primary'">
                            {{ ticket.tipoPago }}
                        </span>
                    </td>
                    <td>{{ Number(ticket.total).toFixed(2) }}</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-info" v-on:click="abrirDetalle(ticket.id)"
                                    title="Ver Recibo">
                                <i class="bi bi-eye"></i>
                            </button>
                            @if (User.IsInRole("Administrador"))
                            {
                                <button class="btn btn-sm btn-outline-danger" v-on:click="abrirAnulacion(ticket)">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <nav v-if="totalPaginas > 1" class="mt-3">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item" :class="{ disabled: pagina <= 1 }">
                    <button type="button" class="page-link" v-on:click="irAPagina(pagina - 1)">Anterior</button>
                </li>
                <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === pagina }">
                    <button type="button" class="page-link" v-on:click="irAPagina(p)">{{ p }}</button>
                </li>
                <li class="page-item" :class="{ disabled: pagina >= totalPaginas }">
                    <button type="button" class="page-link" v-on:click="irAPagina(pagina + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
    <partial name="_AnularModal" />
    <partial name="_DetallesTicketModal" />
</div>
@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="~/js/tickets.js" asp-append-version="true"></script>
}

<style>
    [v-cloak] {
        display: none;
    }
</style>