<!DOCTYPE html>
<html lang="es">

<head>
    <partial name="_HeadCommon" />
    <title>@ViewData["Title"] - Dulces Duendes</title>
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>

<body>
    <div class="dd-shell">
        <partial name="_Topbar" />
        @await Component.InvokeAsync("Sidebar")
        <main class="dd-content" role="main">
            @RenderBody()
        </main>
    </div>

    <partial name="_LogoutModal" />
    <partial name="_ModalConfirmar" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/confirmar.js" asp-append-version="true"></script>
    <script src="~/js/reloj.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
