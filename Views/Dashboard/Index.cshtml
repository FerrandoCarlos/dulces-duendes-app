@model DulcesDuendesApp.Models.ViewModels.DashboardViewModel
@using System.Globalization
@using System.Security.Claims

@{
    ViewData["Title"] = "Inicio";
    var nombre = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? string.Empty;
    var pesos = new CultureInfo("es-AR");
}

<div class="mb-4">
    <h1 class="h3 mb-1">Hola, @nombre</h1>
    <p class="text-muted mb-0">Resumen del negocio.</p>
</div>
<section class="mb-4" aria-labelledby="titulo-productos">
    <h2 class="h5 mb-3" id="titulo-productos">Productos</h2>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card dd-kpi h-100">
                <div class="card-body">
                    <div class="dd-kpi-valor">@Model.ProductosActivos</div>
                    <div class="dd-kpi-etiqueta">Productos Activos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card dd-kpi dd-kpi-alerta h-100">
                <div class="card-body">
                    <div class="dd-kpi-valor">@Model.StockBajo</div>
                    <div class="dd-kpi-etiqueta">Con Stock bajo</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card dd-kpi dd-kpi-peligro h-100">
                <div class="card-body">
                    <div class="dd-kpi-valor">@Model.SinStock</div>
                    <div class="dd-kpi-etiqueta">Sin Stock</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="mb-4" aria-labelledby="titulo-reponer">
    <h2 class="h5 mb-3" id="titulo-reponer">Para reponer</h2>
    @if (!Model.AReponer.Any())
    {
        <p class="text-muted">Todo en orden: no hay productos con stock bajo.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Productos</th>
                        <th class="text-end">Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.AReponer)
                    {
                        var claseStock = p.Stock == 0 ? "bg-danger" : "bg-warning text-dark";
                        <tr>
                            <td>@p.Descripcion</td>
                            <td class="text-end"><span class="badge @claseStock">@p.Stock</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Admin is { } admin)
{
    <section class="mb-4" aria-labelledby="titulo-admin">
        <h2 class="h5 mb-3" id="titulo-admin">Administración</h2>
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="card dd-kpi h-100">
                    <div class="card-body">
                        <div class="dd-kpi-valor">@admin.UsuariosActivos</div>
                        <div class="dd-kpi-etiqueta">Usuarios Activos</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card dd-kpi h-100">
                    <div class="card-body">
                        <div class="dd-kpi-valor">@admin.UsuariosInactivos</div>
                        <div class="dd-kpi-etiqueta">Usuarios Inactivos</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card dd-kpi h-100">
                    <div class="card-body">
                        <div class="dd-kpi-valor">@admin.Administradores</div>
                        <div class="dd-kpi-etiqueta">Administradores</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3"></div>
            <div class="col-12 col-md-6">
                <div class="card dd-kpi h-100">
                    <div class="card-body">
                        <div class="dd-kpi-valor">@admin.ValorInventario.ToString("C", pesos)</div>
                        <div class="dd-kpi-etiqueta">Valor del inventario (a costo)</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card dd-kpi h-100">
                    <div class="card-body">
                        <div class="dd-kpi-valor">@admin.GananciaEstimada.ToString("C", pesos)</div>
                        <div class="dd-kpi-etiqueta">Ganancia estimada si se vende todo</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
<section aria-labelledby="titulo-accesos">
    <h2 class="h5 mb-3" id="titulo-accesos">Accesos rápidos</h2>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-box-seam"></i> Productos
        </a>
        <a asp-controller="TiposProducto" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-tags"></i> Tipos de producto
        </a>
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-people"></i> Clientes
        </a>
        <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-receipt"></i> Tickets
        </a>
        @if (Model.Admin is not null)
        {
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-person-gear"></i> Usuarios
            </a>
        }
    </div>
</section>
