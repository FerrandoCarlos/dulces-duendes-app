<div class="modal fade" id="modalCobro" tabindex="-1" ref="modalCobroRef">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-cash-coin me-2"></i>Confirmar Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Tipo de Pago</label>
                    <div class="d-flex gap-3">
                        <div class="form-check flex-fill p-3 border rounded">
                            <input class="form-check-input" type="radio" name="tipoPago" id="pagoEfectivo" value="Efectivo" v-model="tipoPago" v-on:change="cambiarTipoPago">
                            <label class="form-check-label fw-bold cursor-pointer" for="pagoEfectivo">
                                <i class="bi bi-cash me-1 text-success"></i> Efectivo
                            </label>
                        </div>
                        <div class="form-check flex-fill p-3 border rounded">
                            <input class="form-check-input" type="radio" name="tipoPago" id="pagoCtaCte" value="CuentaCorriente" v-model="tipoPago" v-on:change="cambiarTipoPago">
                            <label class="form-check-label fw-bold cursor-pointer" for="pagoCtaCte">
                                <i class="bi bi-person-lines-fill me-1 text-primary"></i> Cuenta Corriente
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3" v-show="tipoPago === 'CuentaCorriente'">
                    <label class="form-label fw-bold">Cliente <span class="text-danger">*</span></label>
                    <select id="selectCliente" class="form-select" style="width: 100%;">
                    </select>
                    <small class="text-danger d-block mt-1" v-if="errorClienteModal">{{ errorClienteModal }}</small>
                </div>

                <div class="card bg-light border-0 mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between fs-5 fw-bold">
                            <span>Total a Cobrar:</span>
                            <span :class="tipoPago === 'Efectivo' ? 'text-success' : 'text-primary'">
                                ${{ (tipoPago === 'Efectivo' ? totalEfectivo : totalCuentaCorriente).toFixed(2) }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" 
                        class="btn btn-success" 
                        v-on:click="guardarTicket" 
                        :disabled="guardando || (tipoPago === 'CuentaCorriente' && !clienteSeleccionado)">
                    <i class="bi bi-check-circle me-1"></i> {{ guardando ? 'Procesando...' : 'Finalizar Venta' }}
                </button>
            </div>
        </div>
    </div>
</div>