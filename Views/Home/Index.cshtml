@model DulcesDuendesApp.Models.Ticket
@{
    ViewData["Title"] = "Ventas";
}

<div class="page-header mb-3">
    <h1>Ventas</h1>
</div>

<form id="antiForgeryForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div id="app-tickets" v-cloak>

    <div v-if="error" class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        {{ error }}
        <button type="button" class="btn-close" v-on:click="error = ''"></button>
    </div>

    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Código de Barras</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-barcode"></i></span>
                        <input type="text" class="form-control" v-model="busquedaCodigo" v-on:keyup.enter="buscarPorCodigo" placeholder="Escanee o ingrese código y Enter..." ref="inputCodigo">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-panel mb-3">
        <table class="table table-striped align-middle" id="tablaTicket">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th style="width: 120px;">Cantidad</th>
                    <th>Stock</th>
                    <th class="text-end">Precio Venta</th>
                    <th class="text-end">Precio Cta. Cte.</th>
                    <th class="text-end">Subtotal (Efectivo)</th>
                    <th class="text-end">Subtotal (Cta. Cte.)</th>
                    <th class="text-center" style="width: 80px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="detalles.length === 0">
                    <td colspan="8" class="text-center text-muted py-4">
                        El ticket está vacío. Ingrese un producto para comenzar.
                    </td>
                </tr>
                <tr v-else v-for="(item, index) in detalles" :key="item.productoId">
                    <td>
                        <strong class="d-block">{{ item.descripcion }}</strong>
                        <small class="text-muted">Cód: {{ item.codigoBarra || 'S/C' }}</small>
                    </td>
                    <td>
                        <input type="number" 
                               class="form-control form-control-sm text-center" 
                               v-model.number="item.cantidad" 
                               min="1"
                               :max="item.stock"
                               v-on:change="validarCantidad(index)"
                               v-on:input="validarCantidad(index)">
                    </td>
                    <td class="text-center">{{ item.stock }}</td>
                    <td class="text-end">${{ Number(item.precioVenta || 0).toFixed(2) }}</td>
                    <td class="text-end">${{ Number(item.precioCuentaCorriente || 0).toFixed(2) }}</td>
                    <td class="text-end fw-bold text-success">
                        ${{ (item.cantidad * (item.precioVenta || 0)).toFixed(2) }}
                    </td>
                    <td class="text-end fw-bold text-primary">
                        ${{ (item.cantidad * (item.precioCuentaCorriente || 0)).toFixed(2) }}
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-danger" v-on:click="quitarProducto(index)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot v-if="detalles.length > 0">
                <tr class="table-light fs-5">
                    <td colspan="5" class="text-end fw-bold">Totales Estimados:</td>
                    <td class="text-end fw-bold text-success">${{ totalEfectivo.toFixed(2) }}</td>
                    <td class="text-end fw-bold text-primary">${{ totalCuentaCorriente.toFixed(2) }}</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2" v-if="detalles.length > 0">
        <button class="btn btn-outline-secondary" v-on:click="limpiarTicket">Vaciar Ticket</button>
        <button class="btn btn-success btn-lg" v-on:click="abrirModalCobro">
            <i class="bi bi-cash-coin me-1"></i> Continuar al Cobro
        </button>
    </div>
    <partial name="_NuevoTicketModal" />
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/ventas.js" asp-append-version="true"></script>
}

<style>
    [v-cloak] {
        display: none;
    }
</style>
