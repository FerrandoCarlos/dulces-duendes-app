@model DulcesDuendesApp.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Dulces Duendes</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
    href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Poppins:wght@600;700;800&display=swap"
    rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS Personalizado -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="login-body">
    <div class="login-wrapper">
        <div class="login-card">
            <h1 class="login-brand">Dulces Duendes</h1>
            <p class="login-subtitle">Sistema de gestión y punto de venta.</p>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3 input-box">
                    <input type="email" id="Email" name="Email" class="form-control" placeholder="Ingrese su email..."
                           autocomplete="username" required />
                    <i class="bi bi-person icon-left"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>


                <div class="mb-3 input-box">
                    <input type="password" id="Password" name="Password" class="form-control"
                           placeholder="Ingrese su contraseña" autocomplete="current-password" required />
                    <i class="bi bi-lock icon-left"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="form-check text-start mb-3">
                    <input asp-for="RecordarMe" class="form-check-input">
                    <label asp-for="RecordarMe" class="form-check-label">Recordarme</label>
                </div>


                <button type="submit" class="btn btn-login w-100">Ingresar</button>
            </form>
        </div>
    </div>
</body>

</html>
