          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/codigo/{{codigoNuevo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
