    {
      "name": "3. Productos: escritura (flujo completo)",
      "description": "Ejecutar en orden con el Collection Runner. Crea un producto, lo consulta, lo modifica y lo elimina.",
      "item": [
        {
          "name": "Crear como empleado (prohibido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Demuestra el control por rol: solo el Administrador escribe.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEmpleado}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarra\": \"{{codigoNuevo}}\",\n  \"descripcion\": \"Producto de prueba API\",\n  \"tipoProductoId\": {{tipoProductoId}},\n  \"stock\": 3,\n  \"precioCosto\": 1000,\n  \"porcentajeGanancia\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigoNuevo\", \"779\" + String(Math.floor(Math.random() * 1e10)).padStart(10, \"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403: el empleado no puede crear\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Costo 1000 y ganancia 50% dan precio de venta 1500.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarra\": \"{{codigoNuevo}}\",\n  \"descripcion\": \"Producto de prueba API\",\n  \"tipoProductoId\": {{tipoProductoId}},\n  \"stock\": 3,\n  \"precioCosto\": 1000,\n  \"porcentajeGanancia\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const p = pm.response.json();",
                  "pm.test(\"Precios calculados por el servidor\", function () {",
                  "  pm.expect(p.precioVenta).to.eql(1500);",
                  "  pm.expect(p.precioCuentaCorriente).to.be.above(p.precioVenta);",
                  "});",
                  "pm.collectionVariables.set(\"productoId\", p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear con código repetido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarra\": \"{{codigoNuevo}}\",\n  \"descripcion\": \"Producto de prueba API\",\n  \"tipoProductoId\": {{tipoProductoId}},\n  \"stock\": 3,\n  \"precioCosto\": 1000,\n  \"porcentajeGanancia\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Mensaje de negocio\", function () { pm.expect(pm.response.json().mensaje).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
