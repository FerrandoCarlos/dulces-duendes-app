                  "  pm.expect(d).to.have.property(\"items\");",
                  "  pm.expect(d).to.have.property(\"totalCount\");",
                  "  pm.expect(d).to.have.property(\"totalPages\");",
                  "  pm.expect(d.page).to.eql(1);",
                  "});"
                ]
              }
