{
  "info": {
    "name": "Dulces Duendes API",
    "description": "Colección de pruebas de la Web API con JWT.\n\nUso: 1) Levantar la app (dotnet run). 2) Ejecutar la carpeta \"1. Autenticación\" para obtener los tokens. 3) Ejecutar el resto con el Collection Runner, en orden.\n\nUsuarios de prueba: admin@dulcesduendes.com / Admin123! y empleado@dulcesduendes.com / Empleado123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el JWT y lo guarda en la variable {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dulcesduendes.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve token Bearer\", function () {",
                  "  pm.expect(datos.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(datos.tipo).to.eql(\"Bearer\");",
                  "});",
                  "pm.collectionVariables.set(\"token\", datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Guarda el JWT del empleado en {{tokenEmpleado}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"empleado@dulcesduendes.com\",\n  \"password\": \"Empleado123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenEmpleado\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
